#!/bin/bash -e

# If running the rails server then create or migrate existing database.
# Match anywhere in the command: Render may pass it as `sh -c "./bin/rails server"`,
# and the Dockerfile's default CMD wraps it in Thruster.
if [[ "$*" == *"./bin/rails server"* ]]; then
  ./bin/rails db:prepare
fi

exec "${@}"
